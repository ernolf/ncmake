{
  "about": "Which audit of zizmor lint-actions-security reports as security. lib/lint-actions-security.mjs names no audit of its own: every audit of data/zizmor-audits.json has one entry here, and its self-test fails where one is missing or names no audit of zizmor. An audit not listed counts as attack until it is sorted.",
  "classes": {
    "attack": "the finding describes a path an attacker can take into the repository, its secrets or what it releases; the finding is security",
    "hardening": "the finding is advice that narrows what a compromise elsewhere could reach; it keeps its level, so it still fails the check, but it is not security"
  },
  "audits": {
    "adhoc-packages": "hardening",
    "anonymous-definition": "hardening",
    "archived-uses": "hardening",
    "artipacked": "hardening",
    "bot-conditions": "attack",
    "cache-poisoning": "attack",
    "concurrency-limits": "hardening",
    "dangerous-triggers": "attack",
    "dependabot-cooldown": "hardening",
    "dependabot-execution": "attack",
    "excessive-permissions": "hardening",
    "forbidden-uses": "hardening",
    "github-app": "attack",
    "github-env": "attack",
    "hardcoded-container-credentials": "attack",
    "impostor-commit": "attack",
    "insecure-commands": "attack",
    "insecure-url-scheme": "attack",
    "known-vulnerable-actions": "attack",
    "misfeature": "hardening",
    "obfuscation": "hardening",
    "overprovisioned-secrets": "hardening",
    "ref-confusion": "attack",
    "ref-version-mismatch": "hardening",
    "secrets-inherit": "attack",
    "secrets-outside-env": "hardening",
    "self-hosted-runner": "hardening",
    "self-repository": "hardening",
    "stale-action-refs": "hardening",
    "superfluous-actions": "hardening",
    "template-injection": "attack",
    "typosquat-uses": "attack",
    "undocumented-permissions": "hardening",
    "unpinned-images": "hardening",
    "unpinned-tools": "hardening",
    "unpinned-uses": "hardening",
    "unredacted-secrets": "attack",
    "unsound-condition": "attack",
    "unsound-contains": "attack",
    "unsound-ternary": "hardening",
    "use-trusted-publishing": "hardening"
  }
}
